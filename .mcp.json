{
  "mcpServers": {
    "helixgen": {
      "command": "uv",
      "args": ["run", "--no-project",
               "--with", "helixgen[mcp,device] @ git+https://github.com/sheax0r/helixgen-core",
               "-m", "mcp_server"],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "HELIXGEN_LIBRARY": "${CLAUDE_PLUGIN_ROOT}/data/library"
      }
    }
  }
}
